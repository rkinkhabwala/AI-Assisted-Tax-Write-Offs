# Copy to .env and fill in. Never commit .env.

# --- Model providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
AGENT_MODEL=claude-sonnet-5
CONTEXT_MODEL=claude-haiku-4-5-20251001

# --- Embeddings / reranking (dimension is fixed at 1024 by migrations/0001_init.sql) ---
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
RERANKER_PROVIDER=voyage
RERANKER_MODEL=rerank-2.5

# --- Database ---
POSTGRES_PORT=5432
DATABASE_URL=postgresql://writeoff:writeoff@localhost:5432/writeoff

# --- Domain ---
SUPPORTED_TAX_YEARS=[2025,2026]

# --- Privacy ---
# Days to keep agent request/tool-call traces (0 = never write traces).
TRACE_RETENTION_DAYS=30
# Days a session may sit idle before it is deleted (0 = keep sessions).
SESSION_RETENTION_DAYS=30

# --- API and UI ---
# Bearer token required on /v1 endpoints. Leave empty only for local development.
API_TOKEN=
# Questions answered at the same time (each spends API credit).
MAX_CONCURRENT_ANSWERS=4
# Where the Streamlit UI finds the API (docker compose sets this for you).
WRITEOFF_API_URL=http://localhost:8000
